# Supabase — à configurer dans Netlify > Site configuration > Environment variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clé service Supabase — JAMAIS préfixée VITE_ (serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — clé publique exposée au client (VITE_), clé secrète serveur uniquement
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Alma — clés serveur uniquement, sans préfixe VITE_
ALMA_API_KEY=sk_test_...
ALMA_MERCHANT_ID=merchant_...
# Facultatif : la bonne API est choisie automatiquement selon sk_test_ ou sk_live_
# ALMA_API_URL=https://api.sandbox.getalma.eu
ALMA_SITE_URL=https://editionmade.com

# Resend — emails transactionnels (serveur uniquement de préférence)
RESEND_API_KEY=re_...

# Mot de passe du back-office admin
VITE_ADMIN_PASSWORD=your-admin-password
