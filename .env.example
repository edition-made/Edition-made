# Supabase — à configurer dans Netlify > Site configuration > Environment variables
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Clé service Supabase — JAMAIS préfixée VITE_ (serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe — clé publique exposée au client (VITE_), clé secrète serveur uniquement
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend — emails transactionnels (serveur uniquement de préférence)
RESEND_API_KEY=re_...

# Mot de passe du back-office admin
VITE_ADMIN_PASSWORD=your-admin-password
